# Netlify – HTTP hlavičky (https://docs.netlify.com/routing/headers/)
# Formát: řádek s cestou, pod ním odsazené řádky "Klíč: hodnota".
# Pokud cestě odpovídá více pravidel, Netlify hlavičky sloučí.
# Build ho kopíruje do výstupu cílů s "NETLIFY": true (netlify-nahled, production); GitHub Pages
# (cíl preview) ho ignoruje a build ho tam nekopíruje. U náhledu na Netlify (PREVIEW true) build do
# zkopírovaného souboru sám připíše pravidlo "/*" s X-Robots-Tag: noindex, nofollow – sem ho nepište.
# CSP je stejná i v <meta http-equiv="Content-Security-Policy"> v _src/index.html, page-template.html
# a 404.html (meta neumí frame-ancestors) – při změně upravte obě místa.
# Kontaktní formulář (Netlify Forms) odesílá na vlastní web: AJAX POST na "/" (connect-src 'self'),
# bez JavaScriptu POST na /dekujeme/ (form-action 'self'). Žádná externí služba není potřeba.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://calendar.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# Fonty a obrázky se nemění (při změně obrázku použijte nový název souboru)
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# CSS a JS nemají v názvu hash – krátká cache s revalidací
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400
